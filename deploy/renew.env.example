# Copy to deploy/renew.env and fill in your own names.
#
# The `:=` form means these are defaults: anything already exported (for
# instance from the cron entry) still wins, so the domain list can be changed
# here without reinstalling cron.

# Every name the certificate must cover, space or comma separated. The first one
# names the certbot lineage unless CERTBOT_CERT_NAME overrides it.
: "${CERTBOT_DOMAINS:=example.edu www.example.edu}"
: "${CERTBOT_CERT_NAME:=example.edu}"
